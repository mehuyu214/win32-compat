export HOME_DIR=$HOME
export VT=$HOME/workspace/vn-trials
export COMPAT=$HOME/workspace/win32-compat
export DISPLAY=:114
export LANG=ja_JP.UTF-8
export LC_ALL=ja_JP.UTF-8
export LOCPATH=$VT/locales
export ALSA_CONFIG_PATH=$VT/asound-null.conf
export __EGL_VENDOR_LIBRARY_DIRS=$VT/sysroot32/root/usr/share/glvnd/egl_vendor.d
export LIBGL_DRIVERS_PATH=$VT/sysroot32/root/usr/lib/i386-linux-gnu/dri
export WINEDEBUG=${WINEDEBUG:--all}
SUP=$VT/qemu10/q32sup82
QEMU_CPU=${QEMU_CPU:-max}
QEMU_BIN=${QEMU_BIN:-$VT/qemu10/usr/bin/qemu-i386}
QEMU="$QEMU_BIN -cpu $QEMU_CPU -L $VT/sysroot32/root"
QEMU8="$VT/qemu/usr/bin/qemu-i386-static"
WINEBIN=$VT/wine32/wine-11.21-x86/bin/wine
